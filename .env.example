# ─── SkipHR Config ────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values
# NEVER commit .env to GitHub

# ── Gmail (mailer.py) ────────────────────────────────────────────────────────
# Your Gmail address
GMAIL_USER=your_email@gmail.com

# Gmail App Password (NOT your real password)
# Get it: myaccount.google.com → Security → 2-Step Verification → App passwords
GMAIL_APP_PASS=xxxx xxxx xxxx xxxx

# ── Groq API (mailer.py) ─────────────────────────────────────────────────────
# Free API key at console.groq.com
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxx

# ── Your Profile (mailer.py) ─────────────────────────────────────────────────
# Used by AI to personalize every email. Edit once, used forever.
# Leave blank to use the default in mailer.py
YOUR_PROFILE=

# ── Resume (mailer.py) ───────────────────────────────────────────────────────
# Path to your resume PDF (place it in this folder)
RESUME_PATH=resume.pdf

# ── Campaign Limits (mailer.py) ──────────────────────────────────────────────
# Max emails to send per day (Gmail limit ~500/day, stay under 50 to be safe)
DAILY_LIMIT=20
# Seconds to wait between emails (avoids spam flags)
DELAY_SECONDS=15

# ── Lead Discovery (find_leads.py) ───────────────────────────────────────────
# Only show YC companies currently hiring (true/false)
HIRING_ONLY=false
# Max leads to collect per run (0 = no limit)
MAX_LEADS=200

# ── Enricher (enrich_leads.py) ───────────────────────────────────────────────
# Seconds to wait between page requests
ENRICH_DELAY=1.5
# Request timeout in seconds
ENRICH_TIMEOUT=8
# Run full SMTP RCPT validation (true/false)
# Set false if your ISP blocks port 25
SMTP_VERIFY=true

# ── Shared ───────────────────────────────────────────────────────────────────
LEADS_FILE=leads.csv
